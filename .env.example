# Copy this file to .env and fill in your values before running docker compose up.

# tstore-interface base URL (no trailing slash)
GF_DATASOURCE_URL=https://your-server/tstore

# Keycloak token endpoint
GF_DATASOURCE_TOKEN_URL=https://your-server/tauth/realms/transpara/protocol/openid-connect/token

# Keycloak client ID
GF_DATASOURCE_CLIENT_ID=textractor

# Keycloak client secret (keep this secret, never commit .env)
GF_DATASOURCE_CLIENT_SECRET=
